#include <iostream>
using namespace std;

//дві змінні дійсних чисел 
int gcd(int a, int b) {
//на 0 ділити не можна
    while (b != 0) {
//тимчасова змінна
        int tempbanana = b;
//змінна б замінюється на остачу від ділення
        b = a % b;
//змінна а міняється з тимчасовою змінною
        a = tempbanana;
        
    }
    return a;
//цикл повторюється поки б не почне дорівнювати нулю
}

//дві змінні дійсних чисел
int lcm(int a, int b) {
    return (a * b) / gcd(a, b);
}

int main() {
    int a, b;

    cout << "Введіть два числа: ";
    cin >> a >> b;

    int nsd = gcd(a, b);
    int nsk = lcm(a, b);

    cout << "НСД(" << a << ", " << b << ") = " << nsd << endl;
    cout << "НСК(" << a << ", " << b << ") = " << nsk << endl;

    return 0;
}
